@page "/Appoinment"
@using QuickMedBlazor.DB
@inject  ApplicationDbContext _dp;
@inject IJSRuntime JSRuntime;

<div class="appointment-section">
    <div class="input-fields">
        <input type="text" placeholder="Name" @bind-value=model.Name />
        <input type="text" placeholder="Age" @bind-value=model.Age />
        <select @bind=model.Gender>
            <option value="" disabled="disabled" selected="selected"> Select Gender</option>
            <option value="1">Male</option>
            <option value="2">Female</option>
            <option value="3">Other</option>
        </select>
        <input type="text" placeholder="Address" @bind-value=model.Address />
        <input type="text" placeholder="Mobile" @bind-value=model.Mobile />
       @*  <input type="text" placeholder="Code" @bind-value=model.Code /> *@
         <input type="date" placeholder="Admission Date" @bind=model.AdmissionDate />
    </div>

    <div class="button-box">
        <div class="button-container">
            <button @onclick="SavePatient"><span class="icon">💾</span> Save </button>
        </div>
    </div>
</div>


@if (patients.Any())
{
    <h3>Patient List</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Actions</th>
                <th>Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Address</th>
                <th>Mobile</th>
                @* <th>Code</th> *@
                <th>Admission Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in patients)
            {
                <tr>
                    <td>
                        <button @onclick="() => EditPatient(patient)" class="icon-button" title="Edit">
                            <span class="icon">✏️</span> <!-- Edit icon -->
                        </button>
                        <button @onclick="() => DeletePatient(patient)" class="icon-button" title="Delete">
                            <span class="icon">🗑️</span> <!-- Delete icon -->
                        </button>
                    </td>
                    <td>@patient.Name</td>
                    <td>@patient.Age</td>
                    <td>@(patient.Gender == 1 ? "Male" : patient.Gender == 2 ? "Female" : "Others")</td>
                    <td>@patient.Address</td>
                    <td>@patient.Mobile</td>
                   @*  <td>@patient.Code</td> *@
                    <td>@patient.AdmissionDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p><em>No Data Available</em></p>
}





@code {

    private List<TblPatient> patients = new();
    private TblPatient model = new();


    protected override async Task OnInitializedAsync()
    {
        try
        {
            patients = new();
            patients = await App.Database.GetTableRowsAsync<TblPatient>("TblPatient");
            AutoGenCode();
        }
        catch (Exception ex)
        {

            throw;
        }

    }

    private async void SavePatient()
    {
        var name = model.Name;
        if (model.Id == Guid.Empty)
        {
            model.Id = Guid.NewGuid();
            var res = _dp.CreateAsync(model);
        }
        else
        {
            model.IsSynced = false;
            await _dp.UpdateAsync(model);
        }
        
        model = new TblPatient();
        await OnInitializedAsync();
        StateHasChanged();
    }

    private void AddPatient()
    {
        // Set the admission date if not already set
        if (model.AdmissionDate == DateTime.MinValue)
        {
            model.AdmissionDate = DateTime.Now;
        }

        patients.Add(model);
        model = new();
    }

    private void EditPatient(TblPatient patient)
    {
        model = patient; // Pre-fill the form with the patient data for editing
    }

    // private async void DeletePatient(Patient patient)
    // {
    //     _dp.DeleteAsync(patient);
    //     OnInitializedAsync();
    // }

    private async void DeletePatient(TblPatient patient)
    {
        bool isConfirmed = await JSRuntime.InvokeAsync<bool>("showDeleteConfirmation", "Delete", "Are you sure you want to delete this record?");

        if (isConfirmed)
        {
            var deleteResult = await _dp.DeleteAsync(patient);

            if (deleteResult == 1)
            {
                await OnInitializedAsync();
                StateHasChanged();
            }
            else
            {
                // Handle the failure case, e.g., show an error message
                Console.WriteLine("Failed to delete patient from the database.");
            }
        }
    }



   

    private void AutoGenCode()
    {
        var getLastPatient = patients.LastOrDefault();
        if (getLastPatient != null)
        {
            model.Code = (Convert.ToInt32(getLastPatient.Code) + 1).ToString();
        }
        else
        {
            model.Code = DateTime.Now.Year + "0001";
        }
    }
  
}
