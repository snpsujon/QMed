@page "/checkUpgrade"
@using QuickMedBlazor.DB
@using QuickMedBlazor.Services

@inject DataSyncService _service;

<h3 style="text-align: center;">Software & Database Update</h3>

<div class="Update-section" style="text-align: center;">
    <div class="button-box">
        <div class="button-container">
            <button style="
                    text-align: center;
                    font-size: 20px;
                    padding: 10px 20px;
                    background-color: #A1045A; /* Primary brand color */
                    color: white;
                    border: none;
                    border-radius: 5px;
                    cursor: pointer;
                    transition: background-color 0.3s;
                "
                    @onclick="CheckingUpgrade"
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="loader"></span> <!-- Loading spinner -->
                }
                else
                {
                    <span>Check Update</span>
                }
            </button>
        </div>
    </div>
    <p class="status-message mt-5 fs-3 fw-bold font-monospace">@StatusMessage</p>
</div>

@code {
    private bool isLoading = false;
    private string StatusMessage = "Please Check For UpDate.";

    private async void checkInternet()
    {
        var hasInternet = Connectivity.Current.NetworkAccess == NetworkAccess.Internet;
        var internetType = Connectivity.Current.ConnectionProfiles.FirstOrDefault();
        await Application.Current.MainPage.DisplayAlert("Internet", $"Status: {hasInternet} Of Type {internetType}", "OK");
    }

    private async void CheckingUpgrade()
    {
        isLoading = true; // Start loading
        StateHasChanged(); // Trigger UI update
        UpdateDB();
        // Simulate an update check with a delay
        await Task.Delay(3000); // Replace this with your actual update checking logic
        StatusMessage = "Data Has Been Updated Successfully";
        // After checking, stop loading
        isLoading = false;
        StateHasChanged(); // Trigger UI update
    }

    private async void UpdateDB()
    {
        await _service.SyncSqlToLiteAsync<TblCompany>("Admin");
        await _service.SyncSqlToLiteAsync<TblGeneric>("Admin");
        await _service.SyncSqlToLiteAsync<TblBrand>("Admin");
    }
}