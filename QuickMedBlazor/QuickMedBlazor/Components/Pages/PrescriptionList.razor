    protected override async Task OnInitializedAsync()
    {
        // doct = await App.ExecuteSqlQueryAsync<TblDoctor>("SELECT * FROM TblDoctor ORDER BY Id DESC LIMIT 1;");

        // var Lk = doct.FirstOrDefault().LicenseKey;

        patients = await App.ExecuteSqlQueryAsync<PerviewPresVM>("select p.Id,t.Address,p.NumberAfter, t.Mobile,  p.Dx, p.OE, p.Ix, p.Advice, p.CC, p.ISDayAfter, p.ISMonthAfter,  t.Name, t.Age, T.Mobile,p.PrescriptionCode,p.PrescriptionDate, p.PrescriptionDetails, CASE WHEN t.Gender=1 THEN 'M' WHEN t.Gender=2 THEN 'F' ELSE 'O'  END AS Gender  from TblPrescription  p  left join TblPatient t on p.PatientId = t.Id order by t.Code desc");

    }

    private void EditPatient(PerviewPresVM patient)
    {

    }

    private async void DeletePatient(PerviewPresVM patient)
    {
        bool isConfirmed = await JSRuntime.InvokeAsync<bool>("showDeleteConfirmation", "Delete", "Are you sure you want to delete this record?");

        if (isConfirmed)
        {
            var sql = $"Delete from TblPrescription where Id = '{patient.Id}'";
            var deleteResult = await App.ExecuteSqlQueryAsync<PerviewPresVM>(sql);
            await OnInitializedAsync();
            StateHasChanged();

        }
    }


    public async void ViewPrescription(PerviewPresVM patient)
    {
       
        showModal = true;
            modal.previewData = patient;
            var sql = "Select * from TblDoctor LIMIT 1;";
            modal.previewData.TblDoctor = new TblDoctor();
            var Doctor =await App.ExecuteSqlQueryAsync<TblDoctor>(sql);
            if (Doctor.Any())
            {
                modal.previewData.TblDoctor = Doctor.First();
            }

    }

