@* @page "/Preeeee" *@
<div id="JuwelKadu" class="modal-overlay" style="@(IsVisible ? "display: block;" : "display: none;")" @onclick="CloseModal">
    <div class="modal-content" @onclick:stopPropagation>
        <span class="close" @onclick="CloseModal">&times;</span>
        <span class="print" @onclick="PrintContent" title="Print">&#128424;</span> <!-- Print icon -->
        <br />
        <hr style="border:1px solid red" />
        <table id="master_table">
            <thead>
                <tr>
                    <th>
                        @if (IsWithHeader == 1)
                        {
                            <div class="header-1" id="header-1" style="background: rgb(233, 233, 233);">
                                <div id="sub-h-1">
                                    <div class="h-line-1">@previewData.TblDoctor.Name</div>
                                    <div class="h-line-2">@previewData.TblDoctor.designation</div>
                                    <div class="h-line-3">@previewData.TblDoctor.department</div>
                                    <div class="h-line-5">@previewData.TblDoctor.passedMedical</div>
                                    <div class="h-line-6">BMDC Reg. No- @previewData.TblDoctor.bmdcRegNo</div>
                                </div>
                                <div id="sub-h-2">
                                    <div class="h-line-7">Chember:</div>
                                    <div class="h-line-8">@previewData.TblDoctor.chemberHospital</div>
                                    <div class="h-line-9">@previewData.TblDoctor.Address</div>
                                    <div class="h-line-10">Mobile: @previewData.TblDoctor.phoneNumber</div>
                                    <div class="h-line-11">Visit Time @previewData.TblDoctor.startTTime - @previewData.TblDoctor.endTime</div>
                                    <div class="h-line-12">@previewData.TblDoctor.offDay Off</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="header-1"
                                 id="header-1"
                                 style="">
                                <div id="sub-h-1">
                                </div>
                                <div id="sub-h-2">
                                </div>
                            </div>
