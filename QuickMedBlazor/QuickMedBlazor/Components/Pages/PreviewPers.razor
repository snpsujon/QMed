    {
        // Start by assuming Windows-style paths
        string folderPath = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile) + "\\Downloads";

        // Adjust for macOS
        if (OperatingSystem.IsMacOS())
        {
            folderPath = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile) + "/Downloads";
        }

        return folderPath;
    }
    private async Task OpenPdfFile(string filePath)
    {
